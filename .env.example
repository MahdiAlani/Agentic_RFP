# Copy to .env and fill in real values. .env is gitignored; this file is committed.

# --- Postgres ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app

# --- Redis ---
REDIS_ADDR=localhost:6379

# --- Auth ---
JWT_SECRET=change-me

# --- MinIO / object storage ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=rfp-documents
MINIO_USE_SSL=false

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
# Grades answers in the quality checks and eval harness
OPENAI_JUDGE_MODEL=gpt-4o

# --- Demo login ---
# Used by `docker compose run --rm seed` (it creates this user) and by the MCP
# server. Pick any password of 8+ characters.
DEMO_EMAIL=demo@corvane.example
DEMO_PASSWORD=
RFP_EMAIL=${DEMO_EMAIL}
RFP_PASSWORD=${DEMO_PASSWORD}

# --- Workers ---
# all | embed | generate
WORKER_TYPE=all
# Optional suffix for workers
WORKER_NAME=
